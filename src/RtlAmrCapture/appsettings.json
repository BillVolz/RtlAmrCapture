{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ServiceConfiguration": {
    "FullPathToRtlAmr": "C:\\go\\bin\\rtlamr.exe",
    "RtlAmrArguments": "-msgtype scm+ -format=json",
    "HangDetectionMinutes": 5,
    "RestartCountToShutdown": 5,
    "SqlCommandTimeoutSeconds": 30,
    "SqlRetryCount": 3,
    "SqlRetryBaseDelayMs": 200,
    "StartupFailuresBeforeExit": 10,
    "RestartBackoffBaseMs": 1000,
    "RestartBackoffMaxMs": 60000,
    "Connections": [
      {
        "ConnectionStringName": "Home",
        "Type": "SqlServer"
      }
    ]
  },
  "ConnectionStrings": 
    {
      "Home": "<STRING_HERE>"
    }
  
}

